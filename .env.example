EMOTION_API_SERVICE_NAME=emotion-api
EMOTION_MODEL_PATH=models/fer2013_mini_XCEPTION.102-0.66.hdf5
FACE_MIN_DETECTION_CONFIDENCE=0.6
EMOTION_API_MAX_UPLOAD_BYTES=5242880
EMOTION_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_GATEWAY_SERVICE_NAME=api-gateway
EMOTION_API_BASE_URL=http://127.0.0.1:8000
AUTH_SERVICE_BASE_URL=http://127.0.0.1:8002
RECOMMENDATION_SERVICE_BASE_URL=http://127.0.0.1:8004
ANALYTICS_SERVICE_BASE_URL=http://127.0.0.1:8005
API_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
API_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
API_GATEWAY_AUTH_LOGIN_RATE_LIMIT=5
API_GATEWAY_EMOTION_DETECT_RATE_LIMIT=10
API_GATEWAY_RECOMMENDATION_RATE_LIMIT=20
API_GATEWAY_FALLBACK_RATE_LIMIT=120
API_GATEWAY_ALLOW_ANONYMOUS_APP_ROUTES=false
API_GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AUTH_SERVICE_NAME=auth-service
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=emotion_music_ai
MONGODB_USERS_COLLECTION=users
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=emotion-music-ai
JWT_EXPIRES_MINUTES=60
AUTH_SERVICE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ANALYTICS_SERVICE_NAME=analytics-service
ANALYTICS_EVENTS_COLLECTION=analytics_events
ANALYTICS_MOOD_TIMELINE_COLLECTION=user_mood_timeline
ANALYTICS_RECOMMENDATION_HISTORY_COLLECTION=user_recommendation_history
ANALYTICS_PLAYBACK_HISTORY_COLLECTION=user_playback_history
ANALYTICS_FAIL_OPEN=true

RECOMMENDATION_SERVICE_NAME=recommendation-service
JAMENDO_CLIENT_ID=replace-with-jamendo-client-id
JAMENDO_API_BASE_URL=https://api.jamendo.com/v3.0
RECOMMENDATION_REQUEST_TIMEOUT_SECONDS=30
RECOMMENDATION_DEFAULT_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=emotion-music-ai
REDIS_FAIL_OPEN=true
RECOMMENDATION_CACHE_TTL_SECONDS=600
RECOMMENDATION_COOLDOWN_SECONDS=60
RECOMMENDATION_RECENT_TRACK_LIMIT=50
RECOMMENDATION_RECENT_TRACK_TTL_SECONDS=86400
RECOMMENDATION_SERVICE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLIENT_ID=emotion-music-ai
KAFKA_FAIL_OPEN=true
KAFKA_CONSUMER_GROUP_ID=emotion-music-ai-recommendation
RECOMMENDATION_PRECOMPUTE_ENABLED=true

# For EC2 Docker deployment beside Airbnb-Replica, docker-compose.ec2.yml
# overrides KAFKA_ENABLED=true and KAFKA_BOOTSTRAP_SERVERS=kafka:29092.
VITE_API_BASE_URL=http://127.0.0.1:8001
